# modu-data 컨테이너 초기화용 자격증명. 실제 값은 같은 디렉터리의 .env 에 두고 커밋하지 않는다.
# 볼륨에 데이터가 이미 있으면 초기화가 다시 일어나지 않는다.
# 그래도 healthcheck 가 이 값을 쓰므로 볼륨에 저장된 현재 비밀번호와 같아야 한다.
MYSQL_ROOT_PASSWORD=
MYSQL_USER_PASSWORD=
MONGO_ROOT_PASSWORD=
MINIO_ROOT_PASSWORD=
COMMERCE_DB_PASSWORD=
# MinIO 데이터를 bind mount 할 호스트 디렉터리 (예: /path/to/minio/data)
MINIO_DATA_DIR=
