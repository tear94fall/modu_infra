# Secret infra(네임스페이스 modu)의 키 목록 — 값은 비워 둔 틀이다. 실제 Secret 은 k8s/create-infra-secret.sh 가 compose 의 .env 에서 만든다.
# 키 이름 = .env 의 변수 이름. pinpoint-docker/.env 에서 온 것만 PINPOINT_ 접두사(data/.env 의 MYSQL_ROOT_PASSWORD 와 이름이 겹친다).
# 같은 스크립트가 Secret 두 개를 더 만든다: mongo-keyfile(mongodb.key ← data/mongodb/mongodb.key), mysqld-exporter(.my.cnf ← monitoring/mysql/.my.cnf).

# ---- data/.env (MINIO_DATA_DIR 은 호스트 경로라 빠진다)
MYSQL_ROOT_PASSWORD=          # mysql-{member,chat,push,profile}(-replica) root
MYSQL_USER_PASSWORD=          # 메신저 소스 DB 의 앱 계정 user (env MYSQL_PASSWORD)
MESSENGER_REPL_PASSWORD=      # 메신저 복제 계정 repl (replica-setup.sh)
MESSENGER_RO_PASSWORD=        # 메신저 읽기 계정 modu_ro
MONGO_ROOT_PASSWORD=          # mongo-0N admin (env MONGO_INITDB_ROOT_PASSWORD)
MINIO_ROOT_PASSWORD=          # minio (MINIO_ROOT_USER=minio)
COMMERCE_DB_PASSWORD=         # mysql-commerce(-replica) root
COMMERCE_REPL_PASSWORD=       # 커머스 복제 계정 repl
COMMERCE_RO_PASSWORD=         # 커머스 읽기 계정 commerce_ro
GHOST_PASSWORD=               # gh-ost 계정 ghost

# ---- monitoring/.env
GRAFANA_USER=                 # env GF_SECURITY_ADMIN_USER
GRAFANA_PASSWORD=             # env GF_SECURITY_ADMIN_PASSWORD
MYSQL_EXPORTER_USER=          # (지금은 안 씀 — mysqld-exporter 는 .my.cnf)
MYSQL_EXPORTER_PASSWORD=
MONGODB_URI=                  # mongodb-exporter (mongodb://admin:…@mongo-01:27017/?replicaSet=mongo-rs&authSource=admin)

# ---- pinpoint-docker/.env (PINPOINT_ + 원래 이름)
PINPOINT_MYSQL_ROOT_PASSWORD=                     # pinpoint-mysql root
PINPOINT_MYSQL_PASSWORD=                          # pinpoint-mysql admin
PINPOINT_ADMIN_PASSWORD=                          # pinpoint-web ADMIN_PASSWORD
PINPOINT_SPRING_DATASOURCE_HIKARI_PASSWORD=       # pinpoint-web JDBC_PASSWORD, SPRING_DATASOURCE_HIKARI_PASSWORD
PINPOINT_SPRING_METADATASOURCE_HIKARI_PASSWORD=   # pinpoint-web SPRING_METADATASOURCE_HIKARI_PASSWORD
PINPOINT_WEB_SECURITY_AUTH_USER=
PINPOINT_WEB_SECURITY_AUTH_ADMIN=
PINPOINT_WEB_SECURITY_AUTH_JWT_SECRETKEY=
