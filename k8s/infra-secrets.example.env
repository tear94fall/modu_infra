# Secret infra(네임스페이스 modu)의 키 목록 — 값은 비워 둔 틀이다. 이 파일을 k8s/infra.env 로 복사해 값을 채운다(infra.env 는 gitignored).
# k8s/create-infra-secret.sh 가 infra.env 를 읽어 Secret infra 를 만들고, 같은 값으로 mysqld-exporter(.my.cnf)도 만든다.
# mongo-keyfile 은 별도 파일 k8s/mongodb.key(gitignored, 1024B — `openssl rand -base64 756 > k8s/mongodb.key`)에서 만든다.
# deploy-service 는 별도 파일 k8s/deploy-github-app.pem(gitignored, GitHub App 비밀키 PKCS#8 PEM)에서 만든다 — 없으면 건너뛴다.
# 키 이름은 compose 시절 .env 의 변수 이름 그대로(pinpoint 것만 PINPOINT_ 접두사 — data/.env 의 MYSQL_ROOT_PASSWORD 와 이름이 겹쳤다).
# 값에 공백·${ 가 있으면 건너뛰므로 넣지 말 것. 따옴표는 벗긴다.

# ---- MySQL·Mongo (base/data) — 오브젝트 스토리지(Ceph RGW)의 키는 Rook 이 만들어 config-repo 로 간다(k8s/ceph)
MYSQL_ROOT_PASSWORD=          # mysql-{member,chat,push,profile}(-replica) root. mysqld-exporter 의 [client] 비밀번호이기도 하다
MYSQL_USER_PASSWORD=          # 메신저 소스 DB 의 앱 계정 user (env MYSQL_PASSWORD)
MESSENGER_REPL_PASSWORD=      # 메신저 복제 계정 repl (data/mysql/replica-setup.sh 가 만든다)
MESSENGER_RO_PASSWORD=        # 메신저 읽기 계정 modu_ro (replica-setup.sh; config-repo 의 replica datasource 비밀번호와 같은 값)
MONGO_ROOT_PASSWORD=          # mongo-0N admin (env MONGO_INITDB_ROOT_PASSWORD)
COMMERCE_DB_PASSWORD=         # mysql-commerce(-replica) root. mysqld-exporter 의 [client.commerce] 비밀번호이기도 하다
PLATFORM_DB_PASSWORD=         # mysql-platform root (deploy-service 배포 이력 DB, 2026-10-07)
PLATFORM_DB_USER_PASSWORD=    # mysql-platform 앱 계정 platform (config-repo deploy-service.yml 의 spring.datasource.master.password 와 같은 값)
PLATFORM_REPL_PASSWORD=       # mysql-platform 복제 계정 repl (data/mysql/replica-setup.sh platform)
PLATFORM_RO_PASSWORD=         # mysql-platform 읽기 계정 platform_ro (replica-setup.sh; config-repo deploy-service.yml 의 spring.datasource.replica.password 와 같은 값)
COMMERCE_REPL_PASSWORD=       # 커머스 복제 계정 repl (replica-setup.sh commerce)
COMMERCE_RO_PASSWORD=         # 커머스 읽기 계정 commerce_ro
GHOST_PASSWORD=               # gh-ost 계정 ghost (data/mysql/ghost-user-setup.sh 가 만들고 ghost.sh 가 쓴다)

# ---- Grafana·exporter (base/observability)
GRAFANA_USER=                 # grafana env GF_SECURITY_ADMIN_USER
GRAFANA_PASSWORD=             # grafana env GF_SECURITY_ADMIN_PASSWORD
MYSQL_EXPORTER_USER=          # (지금은 안 씀 — mysqld-exporter 는 root 로 .my.cnf. 전용 계정을 만들면 그때 쓴다)
MYSQL_EXPORTER_PASSWORD=      # (지금은 안 씀)
MONGODB_URI=                  # mongodb-exporter 접속 URI (mongodb://admin:<MONGO_ROOT_PASSWORD>@mongo-01:27017/?replicaSet=mongo-rs&authSource=admin)

# ---- Pinpoint (base/observability/pinpoint.yaml, PINPOINT_ + 원래 이름)
PINPOINT_MYSQL_ROOT_PASSWORD=                     # pinpoint-mysql root
PINPOINT_MYSQL_PASSWORD=                          # pinpoint-mysql 계정 admin
PINPOINT_ADMIN_PASSWORD=                          # pinpoint-web ADMIN_PASSWORD
PINPOINT_SPRING_DATASOURCE_HIKARI_PASSWORD=       # pinpoint-web·collector JDBC 비밀번호 (= PINPOINT_MYSQL_PASSWORD)
PINPOINT_SPRING_METADATASOURCE_HIKARI_PASSWORD=   # pinpoint-web 메타 DB 비밀번호 (= PINPOINT_MYSQL_PASSWORD)
PINPOINT_WEB_SECURITY_AUTH_USER=                  # pinpoint-web 로그인 사용자
PINPOINT_WEB_SECURITY_AUTH_ADMIN=                 # pinpoint-web 로그인 관리자
PINPOINT_WEB_SECURITY_AUTH_JWT_SECRETKEY=         # pinpoint-web JWT 서명 키
