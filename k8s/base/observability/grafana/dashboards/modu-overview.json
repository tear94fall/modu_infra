    {
      "id": 6,
      "type": "timeseries",
      "title": "느린 엔드포인트 TOP 10 (p95)",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "topk(10, histogram_quantile(0.95, sum by (application, uri, le) (rate(http_server_requests_seconds_bucket[5m]))))",
          "legendFormat": "{{application}} {{uri}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "description": "어느 API 가 느린지. uri 라벨은 경로 템플릿이라 카디널리티가 낮다.",
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
