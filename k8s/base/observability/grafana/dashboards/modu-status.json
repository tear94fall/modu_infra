{
  "uid": "modu-status",
  "title": "모두 서비스 상태판",
  "tags": [
    "modu"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "서비스 UP / DOWN",
      "description": "JVM 서비스·cloudflared·otel-collector 는 Prometheus 스크레이프(up), 콘솔·웹(nginx)은 지표가 없어 kube-state-metrics 의 ready 레플리카로 판단한다.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (service) (up{job=~\"modu-messenger|cloudflared|otel-collector\"}) or max by (service) (label_replace(kube_deployment_status_replicas_ready{namespace=\"modu\",deployment=~\"(modu-admin|modu-system|modu-internal|modu-commerce-web|web-root)\"}, \"service\", \"$1\", \"deployment\", \"(.*)\") > bool 0)",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "legendFormat": "{{service}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 2,
      "type": "table",
      "title": "서비스 한눈에",
      "description": "서비스마다 한 줄(콘솔·웹 nginx 는 UP·ready·재시작·이미지만): UP(Prometheus 스크레이프) · ready/desired(kube-state-metrics Deployment) · 24시간 재시작 · 가동 시간 · 요청률 · 5xx 비율 · ERROR 로그 · JVM 힙 · CPU · 배포된 이미지 태그. 색은 임계값(재시작≥1 주황·≥3 빨강, 5xx≥0.5% 주황, 힙≥80% 주황).",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (service) (up{job=~\"modu-messenger|cloudflared|otel-collector\"}) or max by (service) (label_replace(kube_deployment_status_replicas_ready{namespace=\"modu\",deployment=~\"(modu-admin|modu-system|modu-internal|modu-commerce-web|web-root)\"}, \"service\", \"$1\", \"deployment\", \"(.*)\") > bool 0)",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "format": "table",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "max by (service) (label_replace(kube_deployment_status_replicas_ready{namespace=\"modu\",deployment=~\"((auth|member|chat|chat-store|profile|push|storage|ws|point|commerce|gateway|config|deploy|batch)-service|modu-admin|modu-system|modu-internal|modu-commerce-web|web-root|cloudflared|otel-collector)\"}, \"service\", \"$1\", \"deployment\", \"(.*)\"))",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "format": "table",
          "instant": true
        },
        {
          "refId": "C",
          "expr": "max by (service) (label_replace(kube_deployment_spec_replicas{namespace=\"modu\",deployment=~\"((auth|member|chat|chat-store|profile|push|storage|ws|point|commerce|gateway|config|deploy|batch)-service|modu-admin|modu-system|modu-internal|modu-commerce-web|web-root|cloudflared|otel-collector)\"}, \"service\", \"$1\", \"deployment\", \"(.*)\"))",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "format": "table",
          "instant": true
        },
        {
          "refId": "D",
          "expr": "sum by (service) (label_replace(increase(kube_pod_container_status_restarts_total{namespace=\"modu\",pod=~\"((auth|member|chat|chat-store|profile|push|storage|ws|point|commerce|gateway|config|deploy|batch)-service|modu-admin|modu-system|modu-internal|modu-commerce-web|web-root|cloudflared|otel-collector)-[a-z0-9]+(-[a-z0-9]+)?\"}[24h]), \"service\", \"$1\", \"pod\", \"^(.*?)-[a-z0-9]+(-[a-z0-9]+)?$\"))",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "format": "table",
          "instant": true
        },
        {
          "refId": "E",
          "expr": "max by (service) (process_uptime_seconds{job=\"modu-messenger\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "format": "table",
          "instant": true
        },
        {
          "refId": "F",
          "expr": "sum by (service) (rate(http_server_requests_seconds_count{job=\"modu-messenger\"}[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "format": "table",
          "instant": true
        },
        {
          "refId": "G",
          "expr": "100 * sum by (service) (rate(http_server_requests_seconds_count{job=\"modu-messenger\",status=~\"5..\"}[5m])) / clamp_min(sum by (service) (rate(http_server_requests_seconds_count{job=\"modu-messenger\"}[5m])), 0.0001)",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "format": "table",
          "instant": true
        },
        {
          "refId": "H",
          "expr": "60 * sum by (service) (rate(logback_events_total{job=\"modu-messenger\",level=\"error\"}[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "format": "table",
          "instant": true
        },
        {
          "refId": "I",
          "expr": "100 * sum by (service) (jvm_memory_used_bytes{job=\"modu-messenger\",area=\"heap\"}) / sum by (service) (jvm_memory_max_bytes{job=\"modu-messenger\",area=\"heap\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "format": "table",
          "instant": true
        },
        {
          "refId": "J",
          "expr": "100 * max by (service) (process_cpu_usage{job=\"modu-messenger\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "format": "table",
          "instant": true
        },
        {
          "refId": "K",
          "expr": "max by (service, image) (label_replace(kube_pod_container_info{namespace=\"modu\",pod=~\"((auth|member|chat|chat-store|profile|push|storage|ws|point|commerce|gateway|config|deploy|batch)-service|modu-admin|modu-system|modu-internal|modu-commerce-web|web-root|cloudflared|otel-collector)-[a-z0-9]+(-[a-z0-9]+)?\"}, \"service\", \"$1\", \"pod\", \"^(.*?)-[a-z0-9]+(-[a-z0-9]+)?$\"))",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "format": "table",
          "instant": true
        }
      ],
